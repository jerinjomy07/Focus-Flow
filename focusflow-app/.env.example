# ============================================================
# FOCUSFLOW — Environment Variables Specification
# ============================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local, .env.production, or any real secrets to Git.
#
# ENVIRONMENT SEPARATION:
# - Development: Local development machine (localhost:3000, local DB)
# - Preview:     Vercel ephemeral pull request preview branches (isolated DB branch)
# - Production:  Live customer environment (https://focusflow.app, dedicated Neon DB)
# ============================================================

# ────────────────────────────────────────────────────────────
# 1. DATABASE (Server-Only Secrets)
# ────────────────────────────────────────────────────────────
# Pooled connection string used by Prisma Client at runtime (PgBouncer)
# Dev:        postgresql://postgres:postgres@localhost:5432/focusflow?schema=public
# Production: postgresql://[user]:[password]@[endpoint]-pooler.neon.tech/focusflow?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/focusflow?schema=public"

# Direct non-pooled connection URL — required for Prisma Migrate DDL operations
# Dev:        postgresql://postgres:postgres@localhost:5432/focusflow?schema=public
# Production: postgresql://[user]:[password]@[endpoint].neon.tech/focusflow?sslmode=require
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/focusflow?schema=public"

# ────────────────────────────────────────────────────────────
# 2. AUTHENTICATION (Auth.js v5 / NextAuth — Server-Only Secrets)
# ────────────────────────────────────────────────────────────
# 256-bit cryptographically random secret used to sign JWT session cookies.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="REPLACE_WITH_SECURE_RANDOM_SECRET_MIN_32_CHARS"

# Dedicated mobile JWT signing secret (Required for mobile native authentication)
# MUST be independently configured with minimum 32 characters in Dev, Preview, and Production.
# The server will refuse to sign or verify mobile sessions if this is omitted.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MOBILE_AUTH_SECRET="REPLACE_WITH_INDEPENDENT_MOBILE_SECRET_MIN_32_CHARS"

# Canonical base URL of the deployment
# Dev:        http://localhost:3000
# Preview:    https://${VERCEL_URL} (handled dynamically by trustHost)
# Production: https://focusflow.app
AUTH_URL="http://localhost:3000"

# ────────────────────────────────────────────────────────────
# 3. APPLICATION CONFIGURATION (Public Browser Variables)
# ────────────────────────────────────────────────────────────
# Public base URL of the application (accessible in browser)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Semantic version string displayed in footer and health check endpoint
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ────────────────────────────────────────────────────────────
# 4. DISTRIBUTED RATE LIMITING (Optional / Production Server-Only)
# ────────────────────────────────────────────────────────────
# Upstash Redis REST API or Vercel KV credentials for distributed rate limiting.
# If omitted, FocusFlow automatically falls back to an in-memory sliding-window limiter.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ────────────────────────────────────────────────────────────
# 5. OBSERVABILITY & ERROR MONITORING (Optional)
# ────────────────────────────────────────────────────────────
# Sentry DSN for server-side error capturing
SENTRY_DSN=""

# Sentry DSN for client-side React error boundary
NEXT_PUBLIC_SENTRY_DSN=""

# Structured logger level: fatal, error, warn, info, debug
LOG_LEVEL="info"
